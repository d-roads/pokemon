{
  "version": "investment-backtest-v1",
  "description": "Frozen protocol from plan.md section 4 (October 6, 2026). Changing any value is a new experiment: bump the version and keep the old results.",
  "grades": ["raw", "grade9", "psa10"],
  "entry": { "first": "2022-03", "last": "2025-06", "stepMonths": 3 },
  "excludeFromMonth": "2026-10",
  "lastExitMonth": "2026-08",
  "features": { "windowMonths": 13, "minDistinct": 6, "minPrice": 25, "minAgeMonths": 12 },
  "horizons": [6, 12, 24],
  "primaryHorizon": 12,
  "basket": { "topShare": 0.2, "minCards": 20 },
  "costs": { "saleHaircut": 0.15, "entryFixed": 5, "exitFixed": 5 },
  "missingExitReturn": -1,
  "holdout": { "modulus": 5, "hashMultiplier": 31 },
  "split": { "trainLastEntry": "2022-12", "testFirstEntry": "2024-03" },
  "objective": { "stddevPenalty": 0.5 },
  "models": {
    "momentum": [1, 0, 0],
    "value": [0, 1, 0],
    "lowVol": [0, 0, 1],
    "balanced": [0.3333333333333333, 0.3333333333333333, 0.3333333333333333],
    "momentumValue": [0.5, 0.5, 0],
    "momentumQuality": [0.5, 0, 0.5],
    "valueQuality": [0, 0.5, 0.5]
  },
  "gridSteps": 4,
  "walkForwardYears": [2024, 2025],
  "saleHaircutScenarios": [0, 0.1, 0.15, 0.2],
  "stress": { "buySlippage": 0.05, "acquisitionTax": 0.08, "exitSlippage": 0.05, "saleHaircut": 0.2, "fixed": 5 },
  "upsideCap": 2,
  "priceBands": [[25, 100], [100, 500], [500, null]],
  "bootstrap": { "seed": 123456789, "draws": 5000 },
  "portfolio": { "budget": 2000, "maxPerSet": 3, "maxPerCharacter": 2 },
  "legacyReplayDates": ["2022-06-30", "2023-06-30", "2024-06-30", "2025-06-30"]
}
