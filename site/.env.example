# Copy to .env (never committed). Turns on error reporting to Sentry; leave unset to send nothing.
SENTRY_DSN=
# SENTRY_ENV=local
# Creates the "admin" account the first time the server starts, if it does not exist yet.
# The admin account takes over the watchlist, Dex and alerts saved before accounts existed.
# FUTURESIGHT_ADMIN_PASSWORD=
# Share FutureSight with other devices on your home network (Start-FutureSight.ps1 sets this).
# HOST=0.0.0.0
# Research rank for Japanese cards (ranked only against Japanese cards): off (default) or shadow.
# Off because the frozen rank did not pass its Japanese check (tools/research/investment-backtest-ja-results.json).
# FUTURESIGHT_JA_RESEARCH=off

# Approved eBay Partner Network campaign for manual search links (separate from API keys).
# Leave empty for ordinary eBay links. Use a campaign assigned to your own EPN account.
EBAY_EPN_CAMPAIGN_ID=
# Optional reporting label; no usernames, emails or other personal data.
# EBAY_EPN_CUSTOM_ID=futuresight-manual
