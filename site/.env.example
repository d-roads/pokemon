# Copy to .env (never committed). Turns on error reporting to Sentry; leave unset to send nothing.
SENTRY_DSN=
# SENTRY_ENV=local
# Creates the "admin" account the first time the server starts, if it does not exist yet.
# The admin account takes over the watchlist, Dex and alerts saved before accounts existed.
# FUTURESIGHT_ADMIN_PASSWORD=
# Share FutureSight with other devices on your home network (Start-FutureSight.ps1 sets this).
# HOST=0.0.0.0
